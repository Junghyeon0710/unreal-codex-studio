{
  "description": "Review before trusting. Blocks text patches to Unreal binary assets; does not grant permissions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/guard.py PreToolUse",
            "command_windows": "python .codex/hooks/guard.py PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/guard.py SubagentStart",
            "command_windows": "python .codex/hooks/guard.py SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/guard.py SubagentStop",
            "command_windows": "python .codex/hooks/guard.py SubagentStop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
